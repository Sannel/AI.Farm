# Copy to .env and change for anything other than local development.
POSTGRES_PASSWORD=aifarm
# Shared key for the MCP endpoint and memory API (send "Authorization: Bearer <key>"). Empty = open.
AIFARM_API_KEY=
SERVER_PORT=8080
# Must produce 768-dimension embeddings (the database column size).
EMBEDDING_MODEL=nomic-embed-text
# Host ports for running the server from an IDE against the compose database and Ollama.
POSTGRES_PORT=5432
OLLAMA_PORT=11434
# The model that plays the NPCs (needs tool calling). By default that's an Ollama model; see below
# for Azure AI Foundry. Ollama alternatives: qwen3:4b, qwen3:8b, gemma4:12b (better with a GPU),
# gpt-oss:20b.
BRAIN_MODEL=gemma4:e4b
# --- Azure AI Foundry instead of Ollama --------------------------------------------------------
# BRAIN_PROVIDER=AzureFoundry
# Your resource's endpoint (https://NAME.openai.azure.com or https://NAME.services.ai.azure.com);
# "/openai/v1/" is added for you.
# BRAIN_ENDPOINT=https://my-resource.openai.azure.com
# A full request URL pasted from the portal works too; one ending in /responses uses the Responses
# API (set BRAIN_API=ChatCompletions or Responses to choose explicitly):
# BRAIN_ENDPOINT=https://my-resource.services.ai.azure.com/openai/v1/responses
# BRAIN_MODEL is then the name of your *deployment* in Foundry.
# BRAIN_API_KEY=<key from the Foundry portal>   # leave it empty to sign in with Entra ID instead
#                                               # (set AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET)
# Reasoning models (gpt-5, o-series) refuse a custom temperature: set it empty for them.
# BRAIN_TEMPERATURE=
# -----------------------------------------------------------------------------------------------
# How often an NPC thinks on its own (sooner when a player is near), and a switch.
BRAIN_INTERVAL=00:01:00
# A turn taking longer than this is abandoned (slow models on a CPU need longer).
BRAIN_TURN_TIMEOUT=00:03:00
BRAIN_ENABLED=true
# Size (characters) of each NPC's memory file; per-player files are a third of it. Players within
# BRAIN_PLAYER_MEMORY_RANGE metres have their file in the NPC's briefing.
BRAIN_MEMORY_SIZE=4000
BRAIN_PLAYER_MEMORY_RANGE=15
# Context window for Ollama's models (the brain needs room for persona, briefing and tools).
OLLAMA_CONTEXT_LENGTH=16384
# Use an Ollama somewhere else (e.g. a machine with a GPU) instead of the local container:
# OLLAMA_URL=http://my-gpu-box:11434
# NPC voices: which Kokoro model to download (from the sherpa-onnx tts-models release). The default
# is Kokoro-82M v1.0 at full precision (~350 MB; about 3x faster than real time on a laptop CPU).
# kokoro-int8-multi-lang-v1_0 is smaller (132 MB) but slower on most CPUs.
VOICE_MODEL=kokoro-multi-lang-v1_0
# Folder the server reads it from; leave unset to follow VOICE_MODEL, or set it empty for text-only
# speech bubbles.
# VOICE_DIR=
# The pause between sentences, in milliseconds. Kokoro's own padding (about 200 ms at each full
# stop) is trimmed and this is put back; raise it for a more measured voice.
# VOICE_SENTENCE_PAUSE_MS=90
